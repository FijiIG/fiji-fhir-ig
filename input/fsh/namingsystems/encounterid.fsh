Instance: FijiEncounterIdentifier
InstanceOf: NamingSystem
Usage: #definition
Title: "Fiji Encounter Identifier"
Description: "NamingSystem for encounter identifiers for national systems in Fiji, using a simulated identifier system for demonstration purposes."
* name = "FijiEncounterIdentifier"
* status = #active
* kind = #identifier
* date = "2026-03-31"
* publisher = "Ministry of Health and Medical Services, Fiji"
* responsible = "Ministry of Health and Medical Services, Fiji"

* uniqueId[0].type = #uri
* uniqueId[0].value = "http://fhir.health.gov.fj/identifier/encounter"
* uniqueId[0].preferred = true