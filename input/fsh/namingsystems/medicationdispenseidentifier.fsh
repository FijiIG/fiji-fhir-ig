Instance: FijiMedicationDispenseIdentifier
InstanceOf: NamingSystem
Usage: #definition
Title: "Fiji MSupply Medication Dispense Identifier"
Description: "NamingSystem for Medication Dispense  identifiers in Fiji"
* name = "FijiMedicationDispenseIdentifier"
* status = #active
* kind = #identifier
* date = "2026-10-14"
* publisher = "Ministry of Health and Medical Services, Fiji"
* responsible = "Ministry of Health and Medical Services, Fiji"

* uniqueId[0].type = #uri
* uniqueId[0].value = "http://fhir.health.gov.fj/identifier/msupply-dispense"
* uniqueId[0].preferred = true