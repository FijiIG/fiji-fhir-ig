Instance: FijiPractitionerMedicalRegistrationNumber
InstanceOf: NamingSystem
Usage: #definition
Title: "Fiji Practitioner Medical Registration Number"
Description: "NamingSystem for practitioner medical registration number registration identifiers in Fiji"
* name = "FijiPractitionerMedicalRegistrationNumber"
* status = #active
* kind = #identifier
* date = "2026-10-14"
* publisher = "Ministry of Health and Medical Services, Fiji"
* responsible = "Ministry of Health and Medical Services, Fiji"

* uniqueId[0].type = #uri
* uniqueId[0].value = "http://fhir.health.gov.fj/identifier/practitioner-medical-registration"
* uniqueId[0].preferred = true