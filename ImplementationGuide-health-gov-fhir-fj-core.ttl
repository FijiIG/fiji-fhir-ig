         fhir:link <https://core.fhir.health.gov.fj/Observation/OxygenSaturationExample> ;
         fhir:Reference.reference [ fhir:value "Observation/OxygenSaturationExample" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Oxygen Saturation Observation" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Oxygen saturation measured by pulse oximetry" ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://core.fhir.health.gov.fj/StructureDefinition/fiji-vital-oxygen-saturation" ;
