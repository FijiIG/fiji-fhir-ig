       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Fiji Hospital Example Fiji Divisional Hospital" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Example Fiji hospital organization in Fiji.\nIncludes organizational identifier, contact information, and address." ] ;
