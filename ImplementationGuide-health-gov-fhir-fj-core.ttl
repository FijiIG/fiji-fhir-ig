         fhir:Reference.reference [ fhir:value "StructureDefinition/fiji-admin-zone" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Fiji Health Administration Zone" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The health administration zoning for the patient represented as Division, Sub-divsions, medical area, nursing zone and settlement" ] ;
