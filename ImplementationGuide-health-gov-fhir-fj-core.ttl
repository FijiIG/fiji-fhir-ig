       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://core.fhir.health.gov.fj/StructureDefinition/fiji-location> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/fiji-location" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Fiji Healthcare Location" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "This profile is a placeholder to be extended in subsequent versions of the Fiji Core IG.  \nA Location includes both incidental locations (a place which is used for healthcare without prior designation or authorization) and dedicated, formally appointed locations.\nThese locations are not intended to cover parts of the body, or locations on a patient where something occurred (i.e. a patient's broken leg), but can happily cover the location where the patient broke the leg (the playground)" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
