         fhir:Reference.reference [ fhir:value "StructureDefinition/fiji-patient-occupation" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Fiji Patient Occupation" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Describes occupation of a Fiji Patient.  This is based on the structure of the NZ FHIR Base extension for \n[ACC Patient Occupation](http://hl7.org.nz/fhir/StructureDefinition/acc-patient-occupation)\nbut is separately defined so as to enable a national/regional valueset for occupation codes." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
